{
  "name": "BeanTelligence",
  "version": "6.2.0",
  "schema": 1,
  "description": "Deterministic Zero-Node ordered module concatenation manifest for BeanTelligence v6.2 standalone web PWA and Horizon-2 Capacitor www bundle.",
  "encoding": "utf-8-nobom",
  "defaultOutput": "index.html",
  "pwaAssets": {
    "manifest": "manifest.webmanifest",
    "serviceWorker": "sw.js",
    "iconsDir": "icons"
  },
  "capacitorWww": {
    "webDir": "mobile/www",
    "bundles": {
      "styles": "styles.css",
      "core": "bt-core.js",
      "platform": "bt-platform.js",
      "ui": "bt-ui.js"
    }
  },
